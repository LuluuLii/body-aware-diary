{
  "name": "@body-diary/design-tokens",
  "version": "0.0.1",
  "private": true,
  "description": "Body Diary design tokens — colors, typography, radii, shadows (fresh / earth themes)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.scss": "./src/tokens.scss",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  }
}
