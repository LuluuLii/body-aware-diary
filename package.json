{
  "name": "body-diary",
  "version": "1.0.0",
  "private": true,
  "description": "身体感知日记 - Body Awareness Diary (monorepo root)",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "clean:packages": "pnpm --filter \"./packages/*\" clean",
    "dev:h5": "pnpm build:packages && pnpm --filter @body-diary/weapp dev:h5",
    "dev:weapp": "pnpm build:packages && pnpm --filter @body-diary/weapp dev:weapp",
    "build:h5": "pnpm build:packages && pnpm --filter @body-diary/weapp build:h5",
    "build:weapp": "pnpm build:packages && pnpm --filter @body-diary/weapp build:weapp",
    "typecheck": "pnpm -r typecheck",
    "wx:shot": "node scripts/wx-inspect.mjs screenshot",
    "wx:nav": "node scripts/wx-inspect.mjs navigate",
    "wx:eval": "node scripts/wx-inspect.mjs eval"
  },
  "devDependencies": {
    "miniprogram-automator": "^0.12.1",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "webpack-virtual-modules": "0.5.0"
    },
    "patchedDependencies": {
      "@tarojs/runtime@4.1.11": "patches/@tarojs__runtime@4.1.11.patch"
    }
  }
}
